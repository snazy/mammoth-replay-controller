Let MongoDB test containers start on Linux kernel 6.19 and newer (GitHub runners):
set GLIBC_TUNABLES=glibc.pthread.rseq=1, see https://jira.mongodb.org/browse/SERVER-121912.
Same workaround as Apache Polaris' MongoDbBackendTestFactory. Applies on top of 01.

diff --git a/versioned/storage/mongodb-tests/src/main/java/org/projectnessie/versioned/storage/mongodbtests/MongoDBBackendTestFactory.java b/versioned/storage/mongodb-tests/src/main/java/org/projectnessie/versioned/storage/mongodbtests/MongoDBBackendTestFactory.java
index a4568f106e..b37f86be50 100644
--- a/versioned/storage/mongodb-tests/src/main/java/org/projectnessie/versioned/storage/mongodbtests/MongoDBBackendTestFactory.java
+++ b/versioned/storage/mongodb-tests/src/main/java/org/projectnessie/versioned/storage/mongodbtests/MongoDBBackendTestFactory.java
@@ -65,6 +65,10 @@ public void start(Optional<String> containerNetworkId) {
               MongoDBContainer c =
                   new MongoDBContainer(dockerImage).withLogConsumer(new Slf4jLogConsumer(LOGGER));
               containerNetworkId.ifPresent(c::withNetworkMode);
+              // MongoDB cannot start on Linux kernel 6.19 and newer, see
+              // https://jira.mongodb.org/browse/SERVER-121912.
+              // TODO Remove when SERVER-121912 is fixed and available in a release.
+              c.withEnv("GLIBC_TUNABLES", "glibc.pthread.rseq=1");
               return c;
             });
 
